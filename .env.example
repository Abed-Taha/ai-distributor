# ==========================================
# PROJECT
# ==========================================
APP_NAME=ai-distributor
NODE_ENV=development

# ==========================================
# FRONTEND - NEXT.JS
# ==========================================
WEB_HOST=0.0.0.0
WEB_PORT=4200
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# ==========================================
# BACKEND - NESTJS
# ==========================================
API_HOST=0.0.0.0
API_PORT=3000
FETCH_TIMEOUT=1800000

# NestJS Observability (https://observe.nestjs.com)
# Set OBSERVE_ENABLED=true once valid app key & secret are configured
OBSERVE_ENABLED=false
OBSERVE_APP_KEY=your_observe_app_key
OBSERVE_APP_SECRET=your_observe_app_secret

# ==========================================
# DATABASE - POSTGRESQL / DOCKER
# ==========================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ai_distributor
POSTGRES_USER=ai_distributor
POSTGRES_PASSWORD=ai_distributor123

# ==========================================
# DATABASE - PRISMA
# For commands running directly on your host
# ==========================================
DATABASE_URL=postgresql://ai_distributor:ai_distributor123@localhost:5432/ai_distributor?schema=public

# ==========================================
# AUTHENTICATION
# Replace with a securely generated secret
# ==========================================
AUTH_SECRET=replace_with_a_long_random_secret