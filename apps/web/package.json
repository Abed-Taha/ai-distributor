{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env -- sh -c 'next dev --hostname \"${WEB_HOST:-0.0.0.0}\" --port \"${WEB_PORT:-4200}\"'",
    "build": "next build",
    "start": "dotenv -e ../../.env -- sh -c 'next start --hostname \"${WEB_HOST:-0.0.0.0}\" --port \"${WEB_PORT:-4200}\"'",
    "lint": "eslint"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.20.0"
}
